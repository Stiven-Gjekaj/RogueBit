<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rules of the game. This project must never take a rendering
       dependency. That is what keeps a run reproducible and testable with no
       display attached. -->
  <PropertyGroup>
    <RootNamespace>RogueBit.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- A test builds a map directly, so that it can state the arena it needs
         rather than generating one and hoping something useful is nearby. -->
    <InternalsVisibleTo Include="RogueBit.Core.Tests" />
  </ItemGroup>

</Project>
