<Project>

  <!-- Settings that every project in this repository shares. The version lives
       here so that one edit moves the whole solution, and so that the release
       workflow has a single place to read it from. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>0.1.2-alpha</Version>
    <Authors>Stiven Gjekaj</Authors>
    <Product>RogueBit</Product>
    <RepositoryUrl>https://github.com/Stiven-Gjekaj/RogueBit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
